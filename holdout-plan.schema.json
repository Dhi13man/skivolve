{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dhi13man/skivolve/blob/main/holdout-plan.schema.json",
  "title": "Skivolve sealed holdout plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "status",
    "manifest_sha256",
    "evaluation_mode",
    "generator_provider",
    "generator_adapter_binding",
    "source_bindings",
    "consumption_record_path",
    "seed",
    "comparison_profile",
    "cases",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "$ref": "#/$defs/identifier"
    },
    "status": {
      "const": "sealed"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "evaluation_mode": {
      "enum": [
        "judged",
        "objective_only"
      ]
    },
    "comparator_release_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "comparator_calibration_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "comparator_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "comparator_profile_descriptor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "comparator_profile_authority_registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "objective_acceptance_policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "objective_acceptance_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "generator_provider": {
      "$ref": "#/$defs/providerBinding"
    },
    "generator_adapter_binding": {
      "$ref": "#/$defs/generatorAdapterBinding"
    },
    "comparator_adapter_binding": {
      "$ref": "#/$defs/comparatorAdapterBinding"
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "consumption_record_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "comparison_profile": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparisonBinding"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/caseBinding"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evaluation_mode": {
            "const": "judged"
          }
        },
        "required": [
          "evaluation_mode"
        ]
      },
      "then": {
        "required": [
          "comparator_release_sha256",
          "comparator_calibration_evidence_sha256",
          "comparator_profile_id",
          "comparator_profile_descriptor_sha256",
          "comparator_profile_authority_registry_sha256",
          "comparator_adapter_binding"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "objective_acceptance_policy_id"
              ]
            },
            {
              "required": [
                "objective_acceptance_policy_sha256"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "objective_acceptance_policy_id",
          "objective_acceptance_policy_sha256"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "comparator_release_sha256"
              ]
            },
            {
              "required": [
                "comparator_calibration_evidence_sha256"
              ]
            },
            {
              "required": [
                "comparator_profile_id"
              ]
            },
            {
              "required": [
                "comparator_profile_descriptor_sha256"
              ]
            },
            {
              "required": [
                "comparator_profile_authority_registry_sha256"
              ]
            },
            {
              "required": [
                "comparator_adapter_binding"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concurrency",
            "release_authoritative"
          ],
          "properties": {
            "concurrency": {
              "const": "concurrent"
            },
            "release_authoritative": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concurrency",
            "release_authoritative"
          ],
          "properties": {
            "concurrency": {
              "const": "serialized"
            },
            "release_authoritative": {
              "const": false
            }
          }
        }
      ]
    },
    "providerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "requested_model",
        "executable_sha256",
        "reasoning_effort",
        "billing_basis",
        "protocol_lock",
        "protocol_lock_sha256",
        "execution_policy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "reasoning_effort": {
          "oneOf": [
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "billing_basis": {
          "enum": [
            "metered_api",
            "chatgpt_subscription"
          ]
        },
        "protocol_lock": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!\\./)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\/$).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "protocol_lock_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "execution_policy": {
          "$ref": "#/$defs/executionPolicy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "billing_basis": {
                "const": "metered_api"
              }
            },
            "required": [
              "billing_basis"
            ]
          },
          "then": {
            "properties": {
              "reasoning_effort": {
                "type": "null"
              },
              "protocol_lock": {
                "type": "null"
              },
              "protocol_lock_sha256": {
                "type": "null"
              },
              "execution_policy": {
                "properties": {
                  "concurrency": {
                    "const": "concurrent"
                  },
                  "release_authoritative": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_basis": {
                "const": "chatgpt_subscription"
              }
            },
            "required": [
              "billing_basis"
            ]
          },
          "then": {
            "properties": {
              "requested_model": {
                "enum": [
                  "gpt-5.6-luna",
                  "gpt-5.6-terra"
                ]
              },
              "executable_sha256": {
                "type": "string"
              },
              "reasoning_effort": {
                "type": "string"
              },
              "protocol_lock": {
                "type": "string"
              },
              "protocol_lock_sha256": {
                "type": "string"
              },
              "execution_policy": {
                "properties": {
                  "concurrency": {
                    "const": "serialized"
                  },
                  "release_authoritative": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "billing_basis": {
                "const": "chatgpt_subscription"
              },
              "requested_model": {
                "const": "gpt-5.6-luna"
              }
            },
            "required": [
              "billing_basis",
              "requested_model"
            ]
          },
          "then": {
            "properties": {
              "reasoning_effort": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          }
        }
      ]
    },
    "adapterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "authority_scope",
        "binding_sha256",
        "capability_sha256",
        "config_sha256",
        "contract_revision",
        "role",
        "runtime_provenance_sha256"
      ],
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/identifier"
        },
        "authority_scope": {
          "enum": [
            "diagnostic",
            "production",
            "test"
          ]
        },
        "binding_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capability_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_revision": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "comparison",
            "generation"
          ]
        },
        "runtime_provenance_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "generatorAdapterBinding": {
      "$ref": "#/$defs/adapterBinding",
      "properties": {
        "role": {
          "const": "generation"
        }
      }
    },
    "comparatorAdapterBinding": {
      "$ref": "#/$defs/adapterBinding",
      "properties": {
        "role": {
          "const": "comparison"
        }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "kind",
        "source_commit",
        "source_sha256_by_case"
      ],
      "properties": {
        "variant_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "git_ref",
            "without_skill",
            "worktree"
          ]
        },
        "source_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_sha256_by_case": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "without_skill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source_commit": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "source_commit": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "comparisonBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "control",
        "treatment",
        "repetitions",
        "comparator_order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "control": {
          "$ref": "#/$defs/identifier"
        },
        "treatment": {
          "$ref": "#/$defs/identifier"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "comparator_order": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_tree_sha256",
        "shared_tree_sha256",
        "release_case_fingerprint",
        "skill",
        "critical_expectations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "case_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "shared_tree_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "release_case_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "critical_expectations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assurance",
        "privacy_claim",
        "frozen_before_candidate_evaluation",
        "sealed_after_independent_review",
        "reviewed_by",
        "freeze_record",
        "seal_record"
      ],
      "properties": {
        "assurance": {
          "const": "operator-declared-review-records"
        },
        "privacy_claim": {
          "const": "not-a-cryptographic-privacy-proof"
        },
        "frozen_before_candidate_evaluation": {
          "const": true
        },
        "sealed_after_independent_review": {
          "const": true
        },
        "reviewed_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "freeze_record": {
          "type": "string",
          "minLength": 1
        },
        "seal_record": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
