{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skivolve/suite.schema.json",
  "$ref": "#/$defs/suite",
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "suite_id",
        "seed",
        "repository_root",
        "evaluation_mode",
        "provider",
        "shared_verifier_dir",
        "holdout",
        "variants",
        "comparisons",
        "cases"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schema_version": {
          "const": 1
        },
        "suite_id": {
          "$ref": "#/$defs/identifier"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "repository_root": {
          "$ref": "#/$defs/relativePath"
        },
        "evaluation_mode": {
          "enum": [
            "judged",
            "objective_only"
          ]
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "comparator": {
          "$ref": "#/$defs/comparatorProvider"
        },
        "comparator_profile": {
          "$ref": "#/$defs/comparatorProfile"
        },
        "shared_verifier_dir": {
          "oneOf": [
            {
              "$ref": "#/$defs/sharedVerifierPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "holdout": {
          "$ref": "#/$defs/holdoutConfig"
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/variant"
          }
        },
        "comparisons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/comparison"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluation_mode": {
                "const": "judged"
              }
            },
            "required": [
              "evaluation_mode"
            ]
          },
          "then": {
            "required": [
              "comparator",
              "comparator_profile"
            ],
            "properties": {
              "cases": {
                "items": {
                  "$ref": "#/$defs/judgedCase"
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "comparator"
                  ]
                },
                {
                  "required": [
                    "comparator_profile"
                  ]
                }
              ]
            },
            "properties": {
              "cases": {
                "items": {
                  "$ref": "#/$defs/objectiveCase"
                }
              }
            }
          }
        }
      ]
    },
    "comparatorProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "builtin"
            },
            "id": {
              "enum": [
                "software-engineering-v1",
                "plain-language-revision-v1"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "suite_local"
            },
            "path": {
              "$ref": "#/$defs/suiteFilePath"
            }
          }
        }
      ]
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "$comment": "The runner resolves this relative to the field's declared root. Case paths and context paths may not escape; repository and worktree roots may use parent traversal."
    },
    "suiteFilePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\./)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\/$).+$"
    },
    "bundleSourcePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001f\\ud800-\\udfff])(?!/)(?!\\./)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\/$)(?!.*\\\\)[^\\u0000-\\u001f\\ud800-\\udfff]+$"
    },
    "sharedVerifierPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001f\\ud800-\\udfff])(?!/)(?!\\./)(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*\\/$)(?!.*\\\\)[^\\u0000-\\u001f\\ud800-\\udfff]+$"
    },
    "holdoutConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_ids"
      ],
      "properties": {
        "comparison_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "executable",
            "max_budget_usd",
            "model",
            "timeout_seconds"
          ],
          "properties": {
            "adapter": {
              "const": "claude-cli"
            },
            "billing_basis": {
              "const": "metered_api"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "max_budget_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "billing_basis",
            "executable",
            "model",
            "protocol_lock",
            "reasoning_effort",
            "timeout_seconds"
          ],
          "properties": {
            "adapter": {
              "const": "codex-app-server"
            },
            "billing_basis": {
              "const": "chatgpt_subscription"
            },
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "enum": [
                "gpt-5.6-luna",
                "gpt-5.6-terra"
              ]
            },
            "protocol_lock": {
              "$ref": "#/$defs/suiteFilePath"
            },
            "reasoning_effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra"
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "model": {
                    "const": "gpt-5.6-luna"
                  }
                },
                "required": [
                  "model"
                ]
              },
              "then": {
                "properties": {
                  "reasoning_effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "model",
            "timeout_seconds"
          ],
          "properties": {
            "adapter": {
              "const": "deterministic-fake"
            },
            "billing_basis": {
              "const": "metered_api"
            },
            "max_budget_usd": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        }
      ]
    },
    "comparatorProvider": {
      "allOf": [
        {
          "$ref": "#/$defs/provider"
        },
        {
          "not": {
            "properties": {
              "adapter": {
                "const": "codex-app-server"
              }
            },
            "required": [
              "adapter"
            ]
          }
        }
      ]
    },
    "variant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "without_skill"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "git_ref"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "git_ref"
            },
            "git_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "root",
            "source_ref"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "kind": {
              "const": "worktree"
            },
            "root": {
              "$ref": "#/$defs/relativePath"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "control",
        "treatment",
        "repetitions",
        "comparator_order"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "control": {
          "$ref": "#/$defs/identifier"
        },
        "treatment": {
          "$ref": "#/$defs/identifier"
        },
        "repetitions": {
          "const": 3
        },
        "comparator_order": {
          "const": "ab_ba"
        }
      }
    },
    "caseBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "skill",
        "bundle_source",
        "artifact_contract",
        "split",
        "prompt_file",
        "fixture_dir",
        "verifier",
        "context_files",
        "timeout_seconds",
        "critical_expectations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "bundle_source": {
          "$ref": "#/$defs/bundleSourcePath"
        },
        "artifact_contract": {
          "$ref": "#/$defs/artifactContract"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "holdout"
          ]
        },
        "prompt_file": {
          "$ref": "#/$defs/relativePath"
        },
        "fixture_dir": {
          "$ref": "#/$defs/relativePath"
        },
        "verifier": {
          "$ref": "#/$defs/verifier"
        },
        "context_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "critical_expectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "comparator_contract": {
          "$ref": "#/$defs/comparatorContract"
        }
      }
    },
    "judgedCase": {
      "allOf": [
        {
          "$ref": "#/$defs/caseBase"
        },
        {
          "required": [
            "comparator_contract"
          ]
        }
      ]
    },
    "objectiveCase": {
      "allOf": [
        {
          "$ref": "#/$defs/caseBase"
        },
        {
          "not": {
            "required": [
              "comparator_contract"
            ]
          }
        }
      ]
    },
    "artifactContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "workspace_diff",
            "final_output_text",
            "final_output_json"
          ]
        }
      }
    },
    "comparatorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "performance_basis",
        "qualitative_bases"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "kind": {
                "$ref": "#/$defs/identifier"
              },
              "text": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        },
        "performance_basis": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "detail"
              ],
              "properties": {
                "kind": {
                  "$ref": "#/$defs/identifier"
                },
                "detail": {
                  "type": "string",
                  "minLength": 20
                }
              }
            }
          ]
        },
        "qualitative_bases": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/qualitativeBasis"
          }
        }
      }
    },
    "qualitativeBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "detail"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "detail": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "timeout_seconds",
        "required_tools"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "required_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
